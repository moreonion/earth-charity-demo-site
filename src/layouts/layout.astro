---
import Nav from "@/components/nav.astro";
import GlobalStyles from "@/Styles/globalStyles.astro";
import FoundistDemoStyles from "@/Styles/FoundistDemoStyles.astro";
import { Image } from "astro:assets";
import LogoImage from "@/Images/earth-charity_logo_alt.png";

interface Props {
    title?: string;
}

const { title = "Earth Charity" } = Astro.props;

const pageTitle = title ? `${title}: Earth Charity` : "Earth Charity";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />

        <title>{pageTitle}</title>

        <FoundistDemoStyles />
        <GlobalStyles />

        <slot name="head" />
    </head>
    <body>
        <header>
            <div data-inert-with-nav>
                <a href="/">
                    <Image
                        src={LogoImage}
                        alt="Earth Charity Logo"
                        loading="eager"
                    />
                    <span class="sr-only">Earth Charity</span>
                </a>
            </div>
            <Nav />
        </header>
        <div data-inert-with-nav>
            <main>
                <slot />
            </main>
            <footer>
                <p>
                    Earth Charity is a made-up organisation used to demonstrate
                    Impact Stack. This is a super basic demo website that could
                    be an organisation's main website or any website other than
                    an Impact Stack site. It gives examples of how you might
                    start a supporter's interaction with an Impact Stack form on
                    your main website.
                </p>
            </footer>
        </div>
    </body>
</html>

<style>
    body {
        padding: 2rem;
        @media (min-width: 640px) {
            max-width: 80ch;
            margin: 0 auto;
        }
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        @media (min-width: 640px) {
            flex-direction: column;
        }
    }

    main {
        padding: 2rem 0;
    }
</style>
