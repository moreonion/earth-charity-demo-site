---
import CardGrid from "@/components/cardGrid.astro";
import Layout from "@/layouts/layout.astro";

import LinksImage from "@/Images/henry-perks-tzc7leNh0sA-unsplash.png";

const demos = [
    {
        title: "Hide prefilled Impact Stack form fields",
        href: "/general-techniques/hide-prefilled-fields",
        description:
            "Use this technique to hide prefilled fields. Useful if you want to prefill a form from a form or button on your main website",
        image: LinksImage,
    },
];
---

<Layout title="General techniques: Earth Charity">
    <section>
        <h2>General techniques</h2>
        <p>These are some general techniques that can be used in any page.</p>
        <CardGrid items={demos} />
    </section>
</Layout>
